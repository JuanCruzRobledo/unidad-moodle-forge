# Configuración de esta skill para ESTA máquina.
#
# Copiá este archivo a ".env" (o mejor: corré "python scripts/configurar.py",
# que lo hace por vos y te pide los valores de forma interactiva) y completá
# los datos reales ahí. El archivo real ".env" está gitignoreado -- nunca se
# versiona -- y el propio agente tiene bloqueado leer o editar archivos ".env*"
# por política de seguridad global, así que la carga de la API key real pasa
# siempre por vos (a mano o vía configurar.py), nunca por el chat.
#
# NOTA: este archivo de ejemplo se llama "env.example" (sin el punto inicial)
# a propósito, para no caer bajo esa misma política de bloqueo y poder
# versionarse como plantilla legible.

# --- Material de apoyo (Gamma) ---
# Requiere cuenta Gamma paga (Pro/Ultra/Team/Business) para tener API key.
# Ver references/prompt-gamma-material-apoyo.md.
GAMMA_API_KEY=

# true = la skill corre scripts/gamma_generate.py directo cuando toca generar
# el Material de apoyo de una actividad, sin preguntar cada vez.
# false (default) = la skill entrega el prompt de texto para pegar a mano en Gamma.
GAMMA_AUTOMATIZADO=false

# Tema de Gamma a aplicar (opcional). Vacío = Gamma usa el tema default del
# workspace del usuario en gamma.app.
GAMMA_THEME_ID=

# --- Imagen de encabezado de los PDF con membrete (Práctica, Lectura, ---
# --- Evaluaciones, TPI) ---
# Ruta a una imagen (logo institucional u otra) para el encabezado de los PDF
# generados con render_pdf.py --materia. Vacío (default) = el encabezado va
# SIN imagen, solo el texto "TECNICATURA UNIVERSITARIA EN PROGRAMACION". El
# logo real de UTN/TUP ya está en assets/logo-utn-tup.jpg -- para volver a
# usarlo, apuntá esta variable ahí (ruta relativa a la raíz de la skill o
# absoluta). Se puede overridear puntualmente para una corrida con
# render_pdf.py --logo <ruta>, sin tocar este valor persistente.
PDF_HEADER_LOGO=

# --- Imagen de infografía ---
# Todavía no tiene implementación en la skill -- placeholder para cuando se
# defina cómo generarla (referencia futura de generación de imágenes).
IMAGENES_INFOGRAFIA_AUTOMATIZADO=false
IMAGENES_INFOGRAFIA_PROVEEDOR=nanobanana

# --- NotebookLM ---
# Automatizable por browser (Claude in Chrome u otro MCP de browser automation)
# si el usuario lo tiene disponible -- NotebookLM no tiene API pública, así que
# esto no se activa por variable de entorno, se detecta en tiempo real según
# qué herramientas tenga la sesión. Ver references/notebooklm-guion.md.
NOTEBOOKLM_AUTOMATIZADO=false

# --- Subida de videos a YouTube (YouTube Data API v3) ---
# Requiere que el usuario haya creado sus propias credenciales OAuth en Google
# Cloud Console (proyecto + YouTube Data API v3 habilitada + pantalla de
# consentimiento + cliente OAuth tipo "App de escritorio"). Ver
# references/automatizacion-subida-youtube.md para el paso a paso completo --
# este .env NO reemplaza ese setup, solo activa el atajo una vez que ya existe
# scripts/.youtube_client_secret.json.
YOUTUBE_AUTOMATIZADO=false
